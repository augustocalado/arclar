# ============================================================
# ARC LAR – Variáveis de Ambiente
# ============================================================
# IMPORTANTE: Este arquivo é apenas um modelo.
# Copie para .env.local e preencha com seus dados reais.
# NUNCA commite o .env.local no git.
# ============================================================

# --- SUPABASE ---
# Obtenha em: https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- MERCADO PAGO ---
# Obtenha em: https://mercadopago.com.br → Suas integrações
MERCADOPAGO_ACCESS_TOKEN=seu_access_token_aqui
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=sua_public_key_aqui
MERCADOPAGO_WEBHOOK_SECRET=seu_webhook_secret_aqui

# --- GOOGLE MAPS ---
# Obtenha em: https://console.cloud.google.com → Maps JavaScript API
NEXT_PUBLIC_GOOGLE_MAPS_KEY=sua_google_maps_key_aqui

# --- OPENAI (Módulo de IA) ---
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sua_openai_key_aqui

# --- CONFIGURAÇÕES DO APP ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ARC LAR
NEXT_PUBLIC_APP_WHATSAPP=5511999999999

# --- EMAIL (para notificações) ---
# Recomendado: Resend (https://resend.com) ou SendGrid
RESEND_API_KEY=sua_resend_key_aqui
EMAIL_FROM=no-reply@arclar.com.br


# --- CLOUDFLARE R2 STORAGE (10GB Gratuitos/mês) ---
CLOUDFLARE_R2_ACCOUNT_ID=seu_account_id_cloudflare
CLOUDFLARE_R2_ACCESS_KEY_ID=sua_access_key_r2
CLOUDFLARE_R2_SECRET_ACCESS_KEY=seu_secret_access_key_r2
CLOUDFLARE_R2_BUCKET_NAME=arclar-imoveis
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-seu-id.r2.dev
